# Read-aloud voices (optional). Copy this file to .env.local, which git ignores, and never commit a
# real value. In production these live in the Vercel project settings, for the Production
# environment only (README, "Deploying").
# Provider: fish (default, Fish Audio s2.1-pro-free) or elevenlabs.
VOICE_PROVIDER=
# Fish Audio key: https://fish.audio/app/api-keys
FISH_API_KEY=
# ElevenLabs key (only when VOICE_PROVIDER=elevenlabs). `npx -y @elevenlabs/cli@latest onboard init`
# signs you in and stores one for you.
ELEVENLABS_API_KEY=

# Read-aloud button (not a secret). `on` builds in the era voices and shows the microphone button
# during a day; empty or anything else leaves both out. Off while the voice plan is on the free tier.
VITE_VOICE=

# Production only (the Vercel function): `on` switches /api/voice on; anything else answers 404 and
# never calls a provider. The local dev server ignores it.
VOICE_ENABLED=
