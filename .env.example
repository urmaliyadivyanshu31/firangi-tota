# Read-aloud voices (optional). Copy this file to .env.local, which git ignores, and never commit a
# real value. `npx -y @elevenlabs/cli@latest onboard init` signs you in and stores a key for you.
ELEVENLABS_API_KEY=

# Read-aloud button (not a secret). `on` builds in the era voices and shows the microphone button
# during a day; empty or anything else leaves both out. Off while the voice plan is on the free tier.
VITE_VOICE=
