# Read-aloud voices (optional). Copy this file to .env.local, which git ignores, and never commit a
# real value.
# Provider: fish (default, Fish Audio s2.1-pro-free) or elevenlabs.
VOICE_PROVIDER=
# Fish Audio key: https://fish.audio/app/api-keys
FISH_API_KEY=
# ElevenLabs key (only when VOICE_PROVIDER=elevenlabs). `npx -y @elevenlabs/cli@latest onboard init`
# signs you in and stores one for you.
ELEVENLABS_API_KEY=
